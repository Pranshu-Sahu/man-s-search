---
import ReadingLayout from '../layouts/ReadingLayout.astro';
import ReadingHeader from '../components/ReadingHeader.astro';
import ChapterHeader from '../components/ChapterHeader.astro';
import VocabSidebar from '../components/VocabSidebar.astro';
import PageFooter from '../components/PageFooter.astro';
import PaginationControls from '../components/PaginationControls.astro';

import rawPages from '../data/book_pages.json';
import rawVocab from '../data/vocabulary.json';
import { formatPageContent, type VocabItem, type BookPage } from '../utils/textProcessor';

const totalPages = rawPages.length;
// Server fallback page 1
const activePageData = rawPages[0] as BookPage;
const activeVocab = (rawVocab as VocabItem[]).filter(v => v.page_number === 1);
const initialHtml = formatPageContent(activePageData.text, activeVocab);
---

<ReadingLayout title="Man's Search for Meaning — Reading Room">
  <ReadingHeader currentPage={1} totalPages={totalPages} />

  <main class="reading-main" id="reading-main">
    <div class="reading-layout">
      <!-- Scrapbook Paper Container -->
      <article class="reading-article">
        <div class="scrapbook-paper" id="scrapbook-paper">
          <ChapterHeader
            chapterLabel="Part One"
            title="Experiences in a Concentration Camp"
          />

          <!-- Rendered Book Content -->
          <div class="reading-text" id="reading-text" set:html={initialHtml} />

          <!-- Page Pagination Controls -->
          <PaginationControls currentPage={1} totalPages={totalPages} />

          <PageFooter pageNumber={1} />
        </div>
      </article>

      <!-- Dynamic Sticky Notes Sidebar -->
      <div id="vocab-sidebar-container">
        <VocabSidebar entries={activeVocab} />
      </div>
    </div>
  </main>
</ReadingLayout>

<!-- Client-side script for instant 135-page switching & strict highlighting -->
<script>
  import rawPagesData from '../data/book_pages.json';
  import rawVocabData from '../data/vocabulary.json';
  import { formatPageContent, type VocabItem } from '../utils/textProcessor';

  const totalPages = rawPagesData.length;
  const defaultColors = ['yellow', 'blue', 'pink', 'green', 'orange'];
  const colorMap: Record<string, string> = {
    yellow: 'sticky-note-yellow',
    blue: 'sticky-note-blue',
    pink: 'sticky-note-pink',
    green: 'sticky-note-green',
    orange: 'sticky-note-orange',
  };

  function getPageNumberFromUrl(): number {
    const params = new URLSearchParams(window.location.search);
    const p = parseInt(params.get('page') || '1', 10);
    return isNaN(p) || p < 1 ? 1 : (p > totalPages ? totalPages : p);
  }

  function renderPage(pageNum: number) {
    const pageObj = rawPagesData[pageNum - 1] || rawPagesData[0];
    const pageVocab = (rawVocabData as VocabItem[]).filter(v => v.page_number === pageNum);

    // 1. STRICT HIGHLIGHTING: Only words present in pageVocab get highlighted in yellow
    const htmlContent = formatPageContent(pageObj.text, pageVocab);

    // 2. Update Book Content
    const readingTextEl = document.getElementById('reading-text');
    if (readingTextEl) {
      readingTextEl.innerHTML = htmlContent;
    }

    // 3. Update Chapter Label & Title
    const chapterLabelEl = document.querySelector('.chapter-label');
    const chapterTitleEl = document.querySelector('.chapter-title');
    if (chapterLabelEl && chapterTitleEl) {
      if (pageNum <= 5) {
        chapterLabelEl.textContent = 'Part One';
        chapterTitleEl.textContent = 'Experiences in a Concentration Camp';
      } else if (pageNum >= 93) {
        chapterLabelEl.textContent = 'Part Two';
        chapterTitleEl.textContent = 'Logotherapy in a Nutshell';
      } else {
        chapterLabelEl.textContent = `Page ${pageNum}`;
        chapterTitleEl.textContent = "Man's Search for Meaning";
      }
    }

    // 4. Update Header Progress & Page Info
    const headerPageInfo = document.querySelector('.header-page-info');
    const progressBar = document.getElementById('progress-bar');
    const progressPercent = Math.round((pageNum / totalPages) * 100);

    if (headerPageInfo) {
      headerPageInfo.textContent = `Page ${pageNum} of ${totalPages} (${progressPercent}%)`;
    }
    if (progressBar) {
      progressBar.style.width = `${progressPercent}%`;
    }

    // 5. Update Page Footer
    const pageNumEl = document.querySelector('.page-number');
    if (pageNumEl) {
      pageNumEl.textContent = `~ ${pageNum} ~`;
    }

    // 6. Update Pagination Controls
    const prevBtn = document.getElementById('btn-prev-page') as HTMLAnchorElement;
    const nextBtn = document.getElementById('btn-next-page') as HTMLAnchorElement;
    const pageSelect = document.getElementById('page-select') as HTMLSelectElement;

    if (prevBtn) {
      if (pageNum > 1) {
        prevBtn.classList.remove('disabled');
        prevBtn.href = `?page=${pageNum - 1}`;
      } else {
        prevBtn.classList.add('disabled');
        prevBtn.href = '#';
      }
    }

    if (nextBtn) {
      if (pageNum < totalPages) {
        nextBtn.classList.remove('disabled');
        nextBtn.href = `?page=${pageNum + 1}`;
      } else {
        nextBtn.classList.add('disabled');
        nextBtn.href = '#';
      }
    }

    if (pageSelect) {
      pageSelect.value = String(pageNum);
    }

    // 7. Update Sticky Notes Sidebar
    const sidebarContainer = document.getElementById('vocab-sidebar-container');
    if (sidebarContainer) {
      if (pageVocab.length === 0) {
        sidebarContainer.innerHTML = `
          <aside class="vocab-sidebar" id="vocab-sidebar" style="display: block;">
            <div class="vocab-sidebar-inner">
              <div class="sticky-note sticky-note-yellow" style="opacity: 0.8;">
                <span class="sticky-note-word">No Vocabulary</span>
                <span class="sticky-note-definition">Standard vocabulary for this page. Enjoy your reading!</span>
              </div>
            </div>
          </aside>
        `;
      } else {
        const notesHtml = pageVocab.map((entry, i) => {
          const color = defaultColors[i % defaultColors.length];
          const textForm = entry.text_form || entry.base_form;
          const def = entry.contextual_definition || entry.general_definition;
          const sentence = entry.sample_sentence ? `<span class="sticky-note-sentence">"${entry.sample_sentence}"</span>` : '';
          const badge = entry.cefr_level ? `<span class="sticky-note-badge">${entry.cefr_level}</span>` : '';

          return `
            <div class="sticky-note ${colorMap[color]}" data-vocab-index="${i}" id="note-${i}">
              <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px;">
                <span class="sticky-note-word">${textForm}</span>
                ${badge}
              </div>
              <span class="sticky-note-definition">${def}</span>
              ${sentence}
            </div>
          `;
        }).join('');

        sidebarContainer.innerHTML = `
          <aside class="vocab-sidebar" id="vocab-sidebar" style="display: block;">
            <div class="vocab-sidebar-inner">
              ${notesHtml}
            </div>
          </aside>
        `;
      }
    }

    // 8. Rebind Interactivity (word <-> note click focus)
    bindInteractivity();
  }

  function bindInteractivity() {
    const marks = document.querySelectorAll('.vocab-highlight');
    const notes = document.querySelectorAll('.sticky-note');

    marks.forEach(mark => {
      mark.addEventListener('click', () => {
        const idx = mark.getAttribute('data-vocab-index');
        if (idx !== null) {
          const targetNote = document.getElementById(`note-${idx}`);
          if (targetNote) {
            targetNote.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            targetNote.classList.add('note-focused');
            setTimeout(() => targetNote.classList.remove('note-focused'), 2000);
          }
        }
      });
    });

    notes.forEach(note => {
      note.addEventListener('click', () => {
        const idx = note.getAttribute('data-vocab-index');
        if (idx !== null) {
          const targetMark = document.querySelector(`.vocab-highlight[data-vocab-index="${idx}"]`);
          if (targetMark) {
            targetMark.scrollIntoView({ behavior: 'smooth', block: 'center' });
            targetMark.classList.add('mark-focused');
            setTimeout(() => targetMark.classList.remove('mark-focused'), 2000);
          }
        }
      });
    });
  }

  // Handle Page Change via URL or Controls
  function goToPage(pageNum: number) {
    const url = new URL(window.location.href);
    url.searchParams.set('page', String(pageNum));
    window.history.pushState({}, '', url.toString());
    renderPage(pageNum);

    // Scroll back to top of scrapbook card
    const paper = document.getElementById('scrapbook-paper');
    if (paper) {
      paper.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
  }

  // Initialize page & listeners on DOM ready
  document.addEventListener('DOMContentLoaded', () => {
    const initialPage = getPageNumberFromUrl();
    renderPage(initialPage);

    // Page dropdown select listener
    const pageSelect = document.getElementById('page-select') as HTMLSelectElement;
    if (pageSelect) {
      pageSelect.addEventListener('change', (e) => {
        const val = parseInt((e.target as HTMLSelectElement).value, 10);
        if (!isNaN(val)) goToPage(val);
      });
    }

    // Prev / Next button click handlers
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      const prevBtn = target.closest('#btn-prev-page');
      const nextBtn = target.closest('#btn-next-page');

      if (prevBtn && !prevBtn.classList.contains('disabled')) {
        e.preventDefault();
        const cur = getPageNumberFromUrl();
        if (cur > 1) goToPage(cur - 1);
      } else if (nextBtn && !nextBtn.classList.contains('disabled')) {
        e.preventDefault();
        const cur = getPageNumberFromUrl();
        if (cur < totalPages) goToPage(cur + 1);
      }
    });

    // Keyboard Arrow Key navigation
    document.addEventListener('keydown', (e) => {
      const cur = getPageNumberFromUrl();
      if (e.key === 'ArrowLeft' && cur > 1) {
        goToPage(cur - 1);
      } else if (e.key === 'ArrowRight' && cur < totalPages) {
        goToPage(cur + 1);
      }
    });

    // Browser back/forward button support
    window.addEventListener('popstate', () => {
      renderPage(getPageNumberFromUrl());
    });
  });
</script>

<style is:global>
  .note-focused {
    transform: scale(1.08) rotate(0deg) !important;
    outline: 2px solid var(--primary);
    box-shadow: var(--shadow-lg) !important;
    z-index: 10;
  }

  .mark-focused {
    background-color: rgba(254, 240, 138, 0.95) !important;
    transform: scale(1.05);
  }
</style>
