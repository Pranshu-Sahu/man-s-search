---
import ReadingLayout from '../layouts/ReadingLayout.astro';
import ReadingHeader from '../components/ReadingHeader.astro';
import ChapterHeader from '../components/ChapterHeader.astro';
import PageHeader from '../components/PageHeader.astro';

import rawPages from '../data/book_pages.json';
import rawVocab from '../data/vocabulary.json';
import { formatPageContent, type VocabItem, type BookPage } from '../utils/textProcessor';

const totalPages = rawPages.length;
// Server fallback page 1
const activePageData = rawPages[0] as BookPage;
const activeVocab = (rawVocab as VocabItem[]).filter(v => v.page_number === 1);
const initialHtml = formatPageContent(activePageData.text, activeVocab);
---

<ReadingLayout title="Man's Search for Meaning — Reading Room">
  <ReadingHeader currentPage={1} totalPages={totalPages} />

  <main class="reading-main" id="reading-main">
    <div class="reading-layout">
      <!-- Scrapbook Paper Container -->
      <article class="reading-article">
        <div class="scrapbook-paper" id="scrapbook-paper">
          <PageHeader pageNumber={1} />
          <ChapterHeader
            chapterLabel="Part One"
            title="Experiences in a Concentration Camp"
          />

          <!-- Rendered Book Content -->
          <div class="reading-text" id="reading-text" set:html={initialHtml} />
        </div>
      </article>
    </div>
  </main>

  <!-- Vocabulary Modal -->
  <div id="vocab-modal-overlay" role="dialog" aria-modal="true" aria-labelledby="modal-word">
    <div class="vocab-modal-card modal-yellow" id="vocab-modal-card">
      <button class="vocab-modal-close" id="vocab-modal-close" aria-label="Close">
        <span class="material-symbols-outlined" style="font-size:20px;">close</span>
      </button>
      <div class="vocab-modal-header">
        <span class="vocab-modal-word" id="modal-word"></span>
        <span class="vocab-modal-badge" id="modal-badge"></span>
      </div>
      <div class="vocab-modal-category" id="modal-category"></div>
      <div class="vocab-modal-divider"></div>
      <p class="vocab-modal-definition" id="modal-definition"></p>
      <p class="vocab-modal-sentence" id="modal-sentence"></p>
    </div>
  </div>
</ReadingLayout>

<!-- Client-side script for instant 135-page switching & strict highlighting -->
<script>
  import rawPagesData from '../data/book_pages.json';
  import rawVocabData from '../data/vocabulary.json';
  import { formatPageContent, type VocabItem } from '../utils/textProcessor';

  const totalPages = rawPagesData.length;

  function getPageNumberFromUrl(): number {
    const params = new URLSearchParams(window.location.search);
    const p = parseInt(params.get('page') || '1', 10);
    return isNaN(p) || p < 1 ? 1 : (p > totalPages ? totalPages : p);
  }

  function renderPage(pageNum: number) {
    const pageObj = rawPagesData[pageNum - 1] || rawPagesData[0];
    const pageVocab = (rawVocabData as VocabItem[]).filter(v => v.page_number === pageNum);

    // 1. STRICT HIGHLIGHTING: Only words present in pageVocab get highlighted
    const htmlContent = formatPageContent(pageObj.text, pageVocab);

    // 2. Update Book Content
    const readingTextEl = document.getElementById('reading-text');
    if (readingTextEl) {
      readingTextEl.innerHTML = htmlContent;
    }

    // 3. Show chapter header only on the first page of each part
    const chapterHeaderEl = document.querySelector('.chapter-header') as HTMLElement | null;
    const chapterLabelEl  = document.querySelector('.chapter-label');
    const chapterTitleEl  = document.querySelector('.chapter-title');

    if (pageNum === 1) {
      if (chapterHeaderEl) chapterHeaderEl.style.display = '';
      if (chapterLabelEl)  chapterLabelEl.textContent  = 'Part One';
      if (chapterTitleEl)  chapterTitleEl.textContent  = 'Experiences in a Concentration Camp';
    } else if (pageNum === 93) {
      if (chapterHeaderEl) chapterHeaderEl.style.display = '';
      if (chapterLabelEl)  chapterLabelEl.textContent  = 'Part Two';
      if (chapterTitleEl)  chapterTitleEl.textContent  = 'Logotherapy in a Nutshell';
    } else {
      // Mid-chapter page — hide the header entirely
      if (chapterHeaderEl) chapterHeaderEl.style.display = 'none';
    }

    // 4. Update Header Progress & Page Info
    const headerPageInfo = document.querySelector('.header-page-info');
    const progressBar = document.getElementById('progress-bar');
    const progressPercent = Math.round((pageNum / totalPages) * 100);

    if (headerPageInfo) {
      headerPageInfo.textContent = `Page ${pageNum} of ${totalPages} (${progressPercent}%)`;
    }
    if (progressBar) {
      progressBar.style.width = `${progressPercent}%`;
    }

    // 5. Update Page Header (formerly footer)
    const pageNumEl = document.querySelector('.page-number');
    if (pageNumEl) {
      pageNumEl.textContent = `~ ${pageNum} ~`;
    }

    // 6. Rebind word click -> modal
    bindInteractivity(pageVocab);
  }

  // --- Modal helpers ---
  const modalColors = ['modal-yellow', 'modal-blue', 'modal-pink', 'modal-green', 'modal-orange'];

  function openModal(vocabItem: VocabItem, colorIndex: number) {
    const overlay = document.getElementById('vocab-modal-overlay')!;
    const card    = document.getElementById('vocab-modal-card')!;

    (document.getElementById('modal-word')       as HTMLElement).textContent = vocabItem.text_form || vocabItem.base_form;
    (document.getElementById('modal-badge')      as HTMLElement).textContent = vocabItem.cefr_level || '';
    (document.getElementById('modal-category')   as HTMLElement).textContent = (vocabItem.category || '').replace(/_/g, ' ');
    (document.getElementById('modal-definition') as HTMLElement).textContent = vocabItem.contextual_definition || vocabItem.general_definition;

    const sentenceEl = document.getElementById('modal-sentence') as HTMLElement;
    if (vocabItem.sample_sentence) {
      sentenceEl.textContent = `"${vocabItem.sample_sentence}"`;
      sentenceEl.style.display = '';
    } else {
      sentenceEl.style.display = 'none';
    }

    // Cycle card colour
    card.className = `vocab-modal-card ${modalColors[colorIndex % modalColors.length]}`;

    overlay.classList.add('is-open');
    document.body.style.overflow = 'hidden';
  }

  function closeModal() {
    const overlay = document.getElementById('vocab-modal-overlay')!;
    overlay.classList.remove('is-open');
    document.body.style.overflow = '';
  }

  function bindInteractivity(pageVocab: VocabItem[]) {
    const marks = document.querySelectorAll('.vocab-highlight');

    marks.forEach(mark => {
      mark.addEventListener('click', () => {
        const idx = parseInt(mark.getAttribute('data-vocab-index') || '0', 10);
        const entry = pageVocab[idx];
        if (entry) openModal(entry, idx);
      });
    });
  }

  // Handle Page Change via URL or Controls
  function goToPage(pageNum: number) {
    const url = new URL(window.location.href);
    url.searchParams.set('page', String(pageNum));
    window.history.pushState({}, '', url.toString());

    // Save progress to localStorage (Auto-Resume)
    localStorage.setItem('novel_last_read_page', String(pageNum));

    renderPage(pageNum);

    // Scroll back to top of scrapbook card
    const paper = document.getElementById('scrapbook-paper');
    if (paper) {
      paper.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
  }

  // Initialize page & listeners on DOM ready
  document.addEventListener('DOMContentLoaded', () => {
    let initialPage = 1;
    const params = new URLSearchParams(window.location.search);

    if (params.has('page')) {
      // 1. URL priority
      initialPage = parseInt(params.get('page') || '1', 10);
      if (isNaN(initialPage) || initialPage < 1) initialPage = 1;
      if (initialPage > totalPages) initialPage = totalPages;
      localStorage.setItem('novel_last_read_page', String(initialPage));
    } else {
      // 2. Fallback to localStorage (Auto-Resume)
      const savedPage = localStorage.getItem('novel_last_read_page');
      if (savedPage) {
        initialPage = parseInt(savedPage, 10);
        if (isNaN(initialPage) || initialPage < 1) initialPage = 1;
        if (initialPage > totalPages) initialPage = totalPages;

        // Sync URL to match saved page without history push
        const url = new URL(window.location.href);
        url.searchParams.set('page', String(initialPage));
        window.history.replaceState({}, '', url.toString());
      }
    }

    renderPage(initialPage);

    // Close modal on overlay click or close button
    document.getElementById('vocab-modal-overlay')!.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).id === 'vocab-modal-overlay') closeModal();
    });
    document.getElementById('vocab-modal-close')!.addEventListener('click', closeModal);

    // Close modal on Escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeModal();
    });

    // Keyboard Arrow Key navigation
    document.addEventListener('keydown', (e) => {
      const urlParams = new URLSearchParams(window.location.search);
      const curStr = urlParams.get('page');
      let cur = curStr ? parseInt(curStr, 10) : 1;
      if (isNaN(cur)) cur = 1;

      if (e.key === 'ArrowLeft' && cur > 1) {
        goToPage(cur - 1);
      } else if (e.key === 'ArrowRight' && cur < totalPages) {
        goToPage(cur + 1);
      }
    });

    // Browser back/forward button support
    window.addEventListener('popstate', () => {
      renderPage(getPageNumberFromUrl());
    });
  });
</script>
